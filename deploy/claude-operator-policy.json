{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OnlyTheseRegions",
      "Effect": "Deny",
      "NotAction": ["iam:*", "sts:*", "ce:*", "budgets:*", "s3:ListAllMyBuckets"],
      "Resource": "*",
      "Condition": {"StringNotEquals": {"aws:RequestedRegion": ["us-east-1", "ap-northeast-1"]}}
    },
    {
      "Sid": "NoGpuOrGiantInstances",
      "Effect": "Deny",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:*:*:instance/*",
      "Condition": {"StringLike": {"ec2:InstanceType": [
        "p*", "g*", "inf*", "trn*", "dl*", "x*", "u-*", "hpc*", "*.metal*",
        "*.24xlarge", "*.32xlarge", "*.48xlarge", "*.56xlarge", "*.96xlarge", "*.112xlarge"
      ]}}
    },
    {
      "Sid": "ReadAndDescribe",
      "Effect": "Allow",
      "Action": [
        "sts:GetCallerIdentity",
        "ec2:Describe*", "ec2:GetConsoleOutput",
        "ssm:DescribeInstanceInformation", "ssm:DescribeSessions",
        "ssm:GetCommandInvocation", "ssm:ListCommandInvocations", "ssm:ListCommands",
        "s3:ListAllMyBuckets",
        "ce:GetCostAndUsage", "ce:GetCostForecast", "budgets:ViewBudget"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PublicAmiParameters",
      "Effect": "Allow",
      "Action": ["ssm:GetParameter", "ssm:GetParameters"],
      "Resource": "arn:aws:ssm:*::parameter/aws/service/*"
    },
    {
      "Sid": "LaunchAndNetwork",
      "Effect": "Allow",
      "Action": [
        "ec2:RunInstances", "ec2:CreateTags",
        "ec2:CreateSecurityGroup", "ec2:CreateDefaultSubnet", "ec2:CreateDefaultVpc",
        "ec2:CreateVolume", "ec2:AttachVolume",
        "ec2:RequestSpotInstances", "ec2:CancelSpotInstanceRequests"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ManageOnlyProjectInstances",
      "Effect": "Allow",
      "Action": [
        "ec2:StartInstances", "ec2:StopInstances", "ec2:TerminateInstances", "ec2:RebootInstances",
        "ec2:ModifyInstanceAttribute", "ec2:DetachVolume", "ec2:DeleteVolume",
        "ec2:DeleteSecurityGroup", "ec2:AuthorizeSecurityGroupEgress", "ec2:RevokeSecurityGroupEgress"
      ],
      "Resource": "*",
      "Condition": {"StringEquals": {"ec2:ResourceTag/Project": ["ext-latency-tracker", "alpha-research"]}}
    },
    {
      "Sid": "ShellIntoProjectInstances",
      "Effect": "Allow",
      "Action": ["ssm:SendCommand", "ssm:StartSession"],
      "Resource": "arn:aws:ec2:*:*:instance/*",
      "Condition": {"StringEquals": {"ssm:resourceTag/Project": ["ext-latency-tracker", "alpha-research"]}}
    },
    {
      "Sid": "ShellDocuments",
      "Effect": "Allow",
      "Action": ["ssm:SendCommand", "ssm:StartSession"],
      "Resource": [
        "arn:aws:ssm:*::document/AWS-RunShellScript",
        "arn:aws:ssm:*::document/AWS-StartPortForwardingSession",
        "arn:aws:ssm:*:*:document/SSM-SessionManagerRunShell"
      ]
    },
    {
      "Sid": "OwnSessions",
      "Effect": "Allow",
      "Action": ["ssm:TerminateSession", "ssm:ResumeSession", "ssm:CancelCommand"],
      "Resource": "*"
    },
    {
      "Sid": "ProjectBuckets",
      "Effect": "Allow",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::ext-latency-tracker-*", "arn:aws:s3:::ext-latency-tracker-*/*",
        "arn:aws:s3:::alpha-research-*", "arn:aws:s3:::alpha-research-*/*"
      ]
    },
    {
      "Sid": "NoBucketDeletion",
      "Effect": "Deny",
      "Action": ["s3:DeleteBucket", "s3:PutBucketPolicy", "s3:DeleteBucketPolicy", "s3:PutBucketAcl"],
      "Resource": "*"
    },
    {
      "Sid": "ProjectRolesOnly",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole", "iam:CreateRole", "iam:PutRolePolicy", "iam:GetRolePolicy", "iam:DeleteRolePolicy",
        "iam:AttachRolePolicy", "iam:DetachRolePolicy", "iam:DeleteRole",
        "iam:GetInstanceProfile", "iam:CreateInstanceProfile", "iam:DeleteInstanceProfile",
        "iam:AddRoleToInstanceProfile", "iam:RemoveRoleFromInstanceProfile"
      ],
      "Resource": [
        "arn:aws:iam::*:role/ext-tracker-role", "arn:aws:iam::*:instance-profile/ext-tracker-role",
        "arn:aws:iam::*:role/alpha-research-role", "arn:aws:iam::*:instance-profile/alpha-research-role"
      ]
    },
    {
      "Sid": "OnlySsmManagedPolicyAttach",
      "Effect": "Deny",
      "Action": ["iam:AttachRolePolicy"],
      "Resource": "*",
      "Condition": {"ArnNotEquals": {"iam:PolicyARN": "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"}}
    },
    {
      "Sid": "PassProjectRolesToEc2",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": ["arn:aws:iam::*:role/ext-tracker-role", "arn:aws:iam::*:role/alpha-research-role"],
      "Condition": {"StringEquals": {"iam:PassedToService": "ec2.amazonaws.com"}}
    }
  ]
}
